# Copiar a /opt/homelab/stacks/misfinanzas/.env y rellenar. Este archivo de ejemplo no lleva secretos reales.
# Generar valores aleatorios en la Pi:
#   openssl rand -base64 24   (contraseña de la base de datos)
#   openssl rand -base64 48   (secreto JWT, mínimo 32 caracteres)

DB_PASSWORD=
JWT_SECRET=
# Clave de Groq (tier gratuito) para la lectura de tickets y el chat. Vacía = sin IA
GROQ_API_KEY=
